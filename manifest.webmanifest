{
  "name": "abraCADabra — Notes de chantier VRD",
  "short_name": "abraCADabra",
  "description": "abraCADabra : carnet de notes de chantier sécurisé — photos horodatées, constats VRD structurés, fiches de contrôle, rapports PDF/Word partageables.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F1EA",
  "theme_color": "#F4F1EA",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "photos", "accept": ["image/*"] }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Visite du jour",
      "short_name": "Visite du jour",
      "description": "Ouvrir ou créer la visite d'aujourd'hui sur le chantier courant",
      "url": "./?a=today",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ouvrir Timestamp Camera",
      "short_name": "Timestamp",
      "description": "Lancer l'application de prise de vue horodatée",
      "url": "./?a=timestamp",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Registre des réserves",
      "short_name": "Registre",
      "description": "Ouvrir le registre des réserves du chantier courant",
      "url": "./?a=register",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ]
}
